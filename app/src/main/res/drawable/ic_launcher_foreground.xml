<?xml version="1.0" encoding="utf-8"?>
<!--
  Primo piano dell'icona adattiva: tre barre a capsula di altezza
  crescente, una per cluster (LITTLE, MIDDLE, PRIME).

  Riprende il grafico a barre che l'app mostra gia a schermo, cosi
  icona e interfaccia si riconoscono.

  Geometria: viewport 108x108. La zona sicura (quella visibile con
  qualunque maschera di launcher) e il cerchio centrale di 66dp, cioe
  da 21 a 87 su entrambi gli assi: tutte le barre stanno dentro.

  Ogni barra e una "pill" larga 15 (raggio 7.5 = meta larghezza), con
  la stessa base a y=83 cosi risultano appoggiate su un piano comune.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- LITTLE: la piu bassa, la meno luminosa -->
    <path android:pathData="M34,53 A7.5,7.5 0 0 1 41.5,60.5 L41.5,75.5 A7.5,7.5 0 0 1 34,83 A7.5,7.5 0 0 1 26.5,75.5 L26.5,60.5 A7.5,7.5 0 0 1 34,53 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="34" android:startY="53"
                android:endX="34" android:endY="83">
                <item android:offset="0.0" android:color="#FF3FA9DC" />
                <item android:offset="1.0" android:color="#FF14608E" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- MIDDLE -->
    <path android:pathData="M54,43 A7.5,7.5 0 0 1 61.5,50.5 L61.5,75.5 A7.5,7.5 0 0 1 54,83 A7.5,7.5 0 0 1 46.5,75.5 L46.5,50.5 A7.5,7.5 0 0 1 54,43 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="43"
                android:endX="54" android:endY="83">
                <item android:offset="0.0" android:color="#FF4FC3F7" />
                <item android:offset="1.0" android:color="#FF1A74A9" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- PRIME: la piu alta e la piu luminosa -->
    <path android:pathData="M74,31 A7.5,7.5 0 0 1 81.5,38.5 L81.5,75.5 A7.5,7.5 0 0 1 74,83 A7.5,7.5 0 0 1 66.5,75.5 L66.5,38.5 A7.5,7.5 0 0 1 74,31 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="74" android:startY="31"
                android:endX="74" android:endY="83">
                <item android:offset="0.0" android:color="#FF74DEFF" />
                <item android:offset="1.0" android:color="#FF2289C8" />
            </gradient>
        </aapt:attr>
    </path>

</vector>